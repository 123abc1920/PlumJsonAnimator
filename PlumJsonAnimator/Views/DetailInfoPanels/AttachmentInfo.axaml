<UserControl
    x:Class="PlumJsonAnimator.Views.AttachmentInfo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:viewModels="clr-namespace:PlumJsonAnimator.ViewModels"
    x:DataType="viewModels:AttachmentInfoViewModel"
    Background="{DynamicResource SukiBackgroundBrush}">
    <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource info}" />
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="Plus" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="TrashFill" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="PencilFill" />
                </Button>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    Grid.Column="0"
                    Height="24"
                    FontSize="14"
                    Text="Name:" />
                <TextBlock
                    Grid.Column="1"
                    Height="24"
                    Margin="6,0,0,0"
                    FontSize="14"
                    Text="{Binding CurrentAttachment.Name}">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding CurrentAttachment.Name}" />
                    </ToolTip.Tip>
                </TextBlock>
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock
                    Grid.Column="0"
                    Height="24"
                    FontSize="14"
                    Text="Type:" />
                <Canvas
                    Grid.Column="1"
                    Width="10"
                    Height="10"
                    Margin="8,0,4,0"
                    Background="{Binding CurrentAttachment.AttachmentTypeColor}" />
                <TextBlock
                    Grid.Column="2"
                    Height="24"
                    FontSize="14"
                    Text="{Binding Type}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    Grid.Column="0"
                    Height="24"
                    FontSize="14"
                    Text="Slot:" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,0,5"
                        Padding="6,4"
                        DisplayMemberBinding="{Binding Name}"
                        FontSize="13"
                        ItemsSource="{Binding Slots}"
                        SelectedItem="{Binding SelectedSlot, Mode=TwoWay}">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding SelectedSlot.Name}" />
                        </ToolTip.Tip>
                    </ComboBox>
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding OpenSlot}">
                        <iconPacks:PackIconBootstrapIcons Kind="ArrowBarRight" />
                    </Button>
                </Grid>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    Grid.Column="0"
                    Height="24"
                    FontSize="14"
                    Text="Skin:" />
                <ComboBox
                    Grid.Column="1"
                    Margin="0,0,0,5"
                    Padding="6,4"
                    DisplayMemberBinding="{Binding Name}"
                    FontSize="13"
                    ItemsSource="{Binding Skins}"
                    SelectedItem="{Binding SelectedSkin, Mode=TwoWay}">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding SelectedSkin.Name}" />
                    </ToolTip.Tip>
                </ComboBox>
            </Grid>
            <ContentControl Content="{Binding CurrentAttachmentProperties}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
