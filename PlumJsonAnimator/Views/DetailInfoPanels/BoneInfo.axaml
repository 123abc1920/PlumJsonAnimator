<UserControl
    x:Class="PlumJsonAnimator.Views.BoneInfo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:viewModels="clr-namespace:PlumJsonAnimator.ViewModels"
    x:DataType="viewModels:MainWindowViewModel"
    Background="{DynamicResource SukiBackgroundBrush}">
    <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
        <StackPanel IsEnabled="{Binding IsAnimMode}">
            <TextBlock Text="{DynamicResource info}" />
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding AddSlot}">
                    <iconPacks:PackIconBootstrapIcons Kind="Plus" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding DeleteSlot}"
                    CommandParameter="{Binding ElementName=SlotsList}">
                    <iconPacks:PackIconBootstrapIcons Kind="TrashFill" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding RenameSlot}"
                    CommandParameter="{Binding ElementName=SlotsList}">
                    <iconPacks:PackIconBootstrapIcons Kind="PencilFill" />
                </Button>
            </StackPanel>
            <TextBlock
                Margin="0,5"
                FontWeight="Bold"
                Text="{Binding CurrentBone.Name}" />
            <ListBox
                x:Name="SlotsList"
                DragDrop.Drop="OnListBoxDrop"
                IsVisible="{Binding CurrentBone}"
                ItemsSource="{Binding CurrentBone.Slots}">
                <DragDrop.AllowDrop>True</DragDrop.AllowDrop>

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border
                                    Name="PART_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter
                                        Name="PART_ContentPresenter"
                                        HorizontalAlignment="Stretch"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>

                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource SukiAccentColor}" />
                        <Setter Property="Foreground" Value="{DynamicResource SukiTextColor}" />
                    </Style>

                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
                    </Style>

                    <Style Selector="ListBoxItem:selected:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SukiAccentColor}" />
                        <Setter Property="Opacity" Value="0.9" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            DoubleTapped="OnSlotSelectionChanged">
                            <DragDrop.AllowDrop>True</DragDrop.AllowDrop>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{Binding Name}" />
                                    </ToolTip.Tip>
                                </TextBlock>

                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="{Binding CurrentAttachment.Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">

                                    <ToolTip.Tip>
                                        <TextBlock Text="{Binding CurrentAttachment.Name}" />
                                    </ToolTip.Tip>
                                </TextBlock>
                            </StackPanel>

                            <NumericUpDown
                                Grid.Column="1"
                                Width="80"
                                MinWidth="60"
                                Margin="12,0,0,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                Increment="1"
                                Value="{Binding CurrentDrawOrderOffset}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
