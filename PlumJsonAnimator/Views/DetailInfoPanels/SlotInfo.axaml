<UserControl
    x:Class="PlumJsonAnimator.Views.SlotInfo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:viewModels="clr-namespace:PlumJsonAnimator.ViewModels"
    x:DataType="viewModels:SlotInfoViewModel"
    Background="{DynamicResource SukiBackgroundBrush}">
    <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
        <StackPanel IsEnabled="{Binding IsAnimMode}">
            <TextBlock Text="{DynamicResource info}" />
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="Plus" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="TrashFill" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="PencilFill" />
                </Button>
                <TextBox
                    Height="32"
                    Margin="0,0,0,5"
                    Text="Name"
                    TextWrapping="Wrap" />
                <TextBlock
                    Height="24"
                    FontSize="14"
                    Text="Bone" />
                <ComboBox
                    Height="32"
                    Margin="0,0,0,5"
                    Padding="6,4"
                    FontSize="13">
                    <ComboBoxItem Content="Item1" IsSelected="True" />
                    <ComboBoxItem Content="Item2" />
                </ComboBox>
                <TextBlock
                    Height="24"
                    FontSize="14"
                    Text="Attachment" />
                <Grid
                    Height="60"
                    Margin="5,0,10,0"
                    Background="#FFF0F0F0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="120"
                        Height="32"
                        HorizontalAlignment="Left"
                        CaretIndex="1"
                        Text="TextBox" />
                    <Canvas
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="#FFE6E6E6" />
                </Grid>
                <ListBox>
                    <ListBox.ItemTemplate>
                        <DataTemplate />
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
