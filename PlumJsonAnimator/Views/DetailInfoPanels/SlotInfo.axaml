<UserControl
    x:Class="PlumJsonAnimator.Views.SlotInfo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:viewModels="clr-namespace:PlumJsonAnimator.ViewModels"
    x:DataType="viewModels:MainWindowViewModel"
    Background="{DynamicResource SukiBackgroundBrush}">
    <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{DynamicResource info}" />
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="Plus" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="TrashFill" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="PencilFill" />
                </Button>
                <ListBox>
                    <DragDrop.AllowDrop>True</DragDrop.AllowDrop>

                    <ListBox.ItemTemplate>
                        <DataTemplate />
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
