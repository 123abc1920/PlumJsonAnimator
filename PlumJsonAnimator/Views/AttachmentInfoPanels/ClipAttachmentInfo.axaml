<UserControl
    x:Class="PlumJsonAnimator.Views.ClipAttachmentInfo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:viewModels="clr-namespace:PlumJsonAnimator.ViewModels"
    x:DataType="viewModels:ClipAttachmentInfoViewModel"
    Background="{DynamicResource SukiBackgroundBrush}">
    <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Height="24"
                FontSize="14"
                Text="Clipping form:" />
            <TextBlock
                Height="24"
                FontSize="14"
                Text="Vertices:" />
            <Button
                Width="32"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding AddVertice}">
                <iconPacks:PackIconBootstrapIcons Kind="Plus" />
            </Button>
            <TextBox
                Height="24"
                FontSize="14"
                Text="End Slot name:" />
            <Grid ColumnDefinitions="*,Auto">
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="0"
                    Height="24"
                    FontSize="14"
                    ItemsSource="{Binding AvailableEndSlotNames}"
                    SelectedValue="{Binding ClipAttachment.EndSlotName, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Name}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="ArrowBarRight" />
                </Button>
            </Grid>
            <ListBox
                Grid.Row="2"
                Margin="0,5"
                ItemsSource="{Binding ClipAttachment.Vertices}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            Orientation="Horizontal">
                            <TextBox HorizontalAlignment="Stretch" Text="{Binding X}" />
                            <TextBox HorizontalAlignment="Stretch" Text="{Binding Y}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
