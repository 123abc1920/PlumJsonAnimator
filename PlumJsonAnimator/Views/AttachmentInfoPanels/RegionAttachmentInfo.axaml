<UserControl
    x:Class="PlumJsonAnimator.Views.RegionAttachmentInfo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:viewModels="clr-namespace:PlumJsonAnimator.ViewModels"
    x:DataType="viewModels:RegionAttachmentInfoViewModel"
    Background="{DynamicResource SukiBackgroundBrush}">
    <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Height="24"
                FontSize="14"
                Text="Image:" />
            <Border
                x:Name="DropBorder"
                MinWidth="200"
                HorizontalAlignment="Left"
                Background="Transparent">
                <TextBox IsHitTestVisible="False" Text="{Binding Image.Path}" />
                <ToolTip.Tip>
                    <TextBlock Text="{Binding Image.Path}" />
                </ToolTip.Tip>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
