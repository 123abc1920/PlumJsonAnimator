<UserControl
    x:Class="PlumJsonAnimator.Views.RegionAttachmentInfo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:viewModels="clr-namespace:PlumJsonAnimator.ViewModels"
    x:DataType="viewModels:RegionAttachmentInfoViewModel"
    Background="{DynamicResource SukiBackgroundBrush}">
    <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Height="24"
                FontSize="14"
                Text="Image:" />
            <TextBox
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Text="{Binding Image.Path}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
